# Copie este archivo como .env y complete los valores de su proyecto Supabase.
# Settings -> API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave ANON, nunca la service_role: esa omite RLS y anularia el control de
# acceso. Por si sola la anon no ve datos; los registros aparecen solo tras
# iniciar sesion con Supabase Auth.
SUPABASE_KEY=

# Tabla que escribe el flujo de n8n con los registros del bot.
SUPABASE_TABLE=registro_labores_maquinaria

# Tabla maestra de labores: traduce el codigo del campo "labor" al nombre.
SUPABASE_ACTIVIDADES_TABLE=actividades

# Maestra de equipos: asocia cada codigo de equipo con su zona.
# El nombre lleva mayusculas y PostgREST es sensible a ellas.
SUPABASE_ZONAS_TABLE=Maestro_Equipos_Zonas
