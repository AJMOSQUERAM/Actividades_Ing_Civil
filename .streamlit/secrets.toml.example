# Plantilla de los Secrets de Streamlit Cloud.
# En la nube: Manage app -> Settings -> Secrets, y se pega este contenido.
# En local no hace falta: la app lee el archivo .env.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "..."   # la clave anon, nunca la service_role
SUPABASE_TABLE = "civil_registros"
SUPABASE_VACACIONES_TABLE = "civil_vacaciones"
